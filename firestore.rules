rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Admins hardcodés ─────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '0SDwLPRnKRaq0SMn0RkjEfWTugl1' ||
        request.auth.uid == 'rfI3GYRmLPcMCCwejgnF22yy1ni2' ||
        request.auth.uid == 'uXNK1h8u01VjUwBENVIu8naJCa42' ||
        request.auth.uid == 'tvR7bgEnaFROAtsxIOqm1oDx4ME3' ||
        request.auth.uid == 'neLeDx68mcVXDyrVgW7RDKRFHUE2'
      );
    }

    function signedIn() {
      return request.auth != null;
    }

    function isCoupleMember(coupleId) {
      // Couple IDs are created as the two UIDs joined with "_".
      // Use anchored regex to avoid accidental substring matches. Accept both
      // uid_partner and partner_uid formats.
      return signedIn() && (
        coupleId.matches('^' + request.auth.uid + '_[^/]+$') ||
        coupleId.matches('^[^/]+_' + request.auth.uid + '$')
      );
    }

    // 1. Profils utilisateurs
    match /users/{userId} {
      allow read: if signedIn() || isAdmin();
      allow create, delete: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow update: if (signedIn() && (
        request.auth.uid == userId ||
        request.resource.data.get('linkedTo', null) == request.auth.uid ||
        (
          resource.data.get('linkedTo', null) == request.auth.uid &&
          !request.resource.data.keys().hasAny(['linkedTo']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['linkedTo', 'linkedAt', 'previousLinkedAt', 'coupleDate', 'proposedDate', 'needsDate', 'archivedPartners', 'lastPartner', 'lastPartnerAt'])
        )
      )) || isAdmin();
    }

    // 2. Profils Cosmétiques (Avatars, bordures...)
    match /userProfiles/{userId} {
      // Le dashboard affiche aussi les cosmétiques du partenaire.
      allow read: if signedIn() || isAdmin();
      allow write: if (signedIn() && request.auth.uid == userId) || isAdmin();
    }

    // 3. Codes de synchronisation (Onboarding)
    match /pairing_codes/{codeId} {
      allow read, write: if signedIn();
    }

    // 4. Messages de contact
    match /contacts/{docId} {
      allow create: if request.auth != null;
      allow read, update: if isAdmin();
    }

    // 5. Données du Couple (Quêtes, Argent, Réponses, Inventaire, etc.)
    match /couples/{coupleId} {
      allow read, write: if isAdmin() || isCoupleMember(coupleId);

      // On applique la même règle pour toutes les sous-collections (economy, daily, progress...)
      match /{document=**} {
        allow read, write: if isAdmin() || isCoupleMember(coupleId);
      }
    }
  }
}