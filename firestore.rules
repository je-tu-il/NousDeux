rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Admins hardcodés ─────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '0SDwLPRnKRaq0SMn0RkjEfWTugl1' ||
        request.auth.uid == 'rfI3GYRmLPcMCCwejgnF22yy1ni2'
      );
    }

    // Par sécurité, on bloque tout ce qui n'est pas explicitement autorisé
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Profils utilisateurs
    match /users/{userId} {
      allow read: if request.auth != null || isAdmin();
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // 2. Profils Cosmétiques (Avatars, bordures...)
    match /userProfiles/{userId} {
      allow read: if request.auth != null || isAdmin();
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // 3. Codes de synchronisation (Onboarding)
    match /pairing_codes/{codeId} {
      allow read, write: if request.auth != null;
    }

    // 4. Messages de contact
    match /contacts/{docId} {
      allow create: if request.auth != null;
      allow read, update: if isAdmin();
    }

    // 5. Données du Couple (Quêtes, Argent, Réponses, Inventaire, etc.)
    match /couples/{coupleId} {
      allow read, write: if isAdmin();
      allow read, write: if request.auth != null && coupleId.matches('.*' + request.auth.uid + '.*');

      // On applique la même règle pour toutes les sous-collections (economy, daily, progress...)
      match /{document=**} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null && coupleId.matches('.*' + request.auth.uid + '.*');
      }
    }
  }
}