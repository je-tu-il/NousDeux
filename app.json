{
  "expo": {
    "name": "NousDeux",
    "slug": "nousdeux",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "sdkVersion": "56.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nousdeuxapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pixelthings.nousdeuxapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.pixelthings.nousdeuxapp"
        ]
      },
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF5F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pixelthings.nousdeux"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "NousDeux",
      "lang": "fr"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF5F2",
          "image": "./assets/images/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1A1514",
            "image": "./assets/images/icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.617698669043-ioqqer8rkgih638t0a2b4d7j1sthg4un"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458783268",
          "userTrackingUsageDescription": "Cette autorisation permet d'afficher des annonces personnalisées."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NousDeux a besoin d'accéder à vos photos pour vous permettre de choisir une photo de profil.",
          "cameraPermission": "NousDeux a besoin d'accéder à votre appareil photo pour vous prendre en photo pour votre profil."
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.pixelthings.nousdeuxapp",
          "widgets": [
            {
              "name": "QuestionWidget",
              "displayName": "NousDeux - Question du Jour",
              "description": "Affiche la question du jour de votre couple sur votre écran d'accueil",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "StreakWidget",
              "displayName": "NousDeux - Flamme & Série",
              "description": "Affiche votre série de jours ensemble et votre flamme",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      "./plugins/withIosWidgets",
      "./plugins/withAndroidWidgets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb65fdb1-87cc-4806-bcf1-7eddb1372f3b"
      }
    }
  }
}
