{
  "expo": {
    "name": "nousdeux",
    "slug": "nousdeux",
    "version": "1.0.0",
    "sdkVersion": "56.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nousdeuxapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pixelthings.nousdeuxapp",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pixelthings.nousdeuxapp"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "NousDeux",
      "lang": "fr"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF5F2",
          "image": "./assets/images/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1A1514",
            "image": "./assets/images/icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.617698669043-ioqqer8rkgih638t0a2b4d7j1sthg4un"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458783268",
          "userTrackingUsageDescription": "Cette autorisation permet d'afficher des annonces personnalisées."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb65fdb1-87cc-4806-bcf1-7eddb1372f3b"
      }
    }
  }
}
