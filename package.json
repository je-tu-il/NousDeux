  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/patch-query-decoder.cjs && node scripts/patch-ios-widgets.js",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:unit": "node --test tests/unit/**/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "build:web:test": "expo export --platform web --output-dir dist-test",
    "preview:web": "node scripts/serve-preview.cjs dist-test 8082",
    "test:e2e:preview": "npm run build:web:test && playwright test --config playwright.preview.config.ts",
    "build:web:local": "node scripts/build-local-preview.cjs",
    "test:e2e:local": "npm run build:web:local && node scripts/seed-local-test.cjs && playwright test --config playwright.local.config.ts"
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "0.5.1",
    "@grpc/grpc-js": "^1.14.3",
    "brace-expansion@^1.0.0": "^1.1.21"
  },
  "engines": {
    "node": ">=20.19.0"
  }
